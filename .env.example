# ---- API ----------------------------------------------------------------
# 로컬 전용. 0.0.0.0 으로 바꾸지 말 것 (docs/11_SECURITY_MODEL.md §1)
CRWALLM_API_HOST=127.0.0.1
CRWALLM_API_PORT=8000

# 변경(mutating) 엔드포인트에 필요한 토큰.
# 커스텀 헤더를 강제해 브라우저 simple request를 차단하는 것이 목적.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRWALLM_API_TOKEN=change-me-generate-a-random-token

# ---- Database -----------------------------------------------------------
# docker-compose publishes PostgreSQL on 5433 by default - 5432 is often
# already taken by a local install. Override with CRWALLM_DB_PORT.
CRWALLM_DATABASE_URL=postgresql+asyncpg://crwallm:crwallm@localhost:5433/crwallm

# ---- Runtime ------------------------------------------------------------
CRWALLM_ENV=dev
CRWALLM_LOG_LEVEL=INFO

# ---- Storage ------------------------------------------------------------
# 원본 아카이브 (Phase 2). 용량이 커지므로 데이터 드라이브 권장.
CRWALLM_ARCHIVE_DIR=./data/archive

# ---- LLM ----------------------------------------------------------------
# The model server runs in the compose stack:
#   docker compose --profile llm up -d
CRWALLM_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
CRWALLM_LLM_MODEL=qwen3.5:9b
CRWALLM_EMBED_MODEL=bge-m3

# Models live under the project (data/ is gitignored) so a checkout is one
# directory to move or delete. Override to share them with another tool.
# CRWALLM_OLLAMA_MODELS=./data/ollama
# CRWALLM_OLLAMA_PORT=11434

# Cloud fallback, for machines without a usable GPU. The config stores a
# *reference*, never the key itself (docs/11_SECURITY_MODEL.md).
# OPENAI_API_KEY=
